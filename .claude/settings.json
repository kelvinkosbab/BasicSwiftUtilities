{
  "permissions": {
    "allow": [
      "Bash(xcodebuild:*)",
      "Bash(swift build:*)",
      "Bash(swift test:*)",
      "Bash(swift package describe:*)",
      "Bash(swift package dump-package:*)",
      "Bash(swift package resolve:*)",
      "Bash(swiftlint:*)",
      "Bash(xcode-select:*)",
      "Bash(./gradlew:*)",
      "Bash(gradle:*)",
      "Bash(ktlint:*)",
      "Bash(adb devices:*)",
      "Bash(adb logcat:*)",
      "Bash(git add:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(pbcopy)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:developer.apple.com)",
      "WebFetch(domain:developer.android.com)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(gh repo delete:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*.p8)",
      "Read(**/*.p12)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/keystore.properties)"
    ]
  }
}
